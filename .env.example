# Copy to .env and fill in. Never commit .env.
# Local development auth: a single shared bearer token.
# Local Compose only. Production must use Cognito auth and must not use this mode.
HEALTEST_API_TOKEN=
HEALTEST_ENV=development
HEALTEST_AUTH_MODE=local-token
# Required for production Cognito auth; set these in AWS task secrets/config.
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# SQLite default (hackathon). Postgres also accepted: postgresql+psycopg2://user:pass@db:5432/healtest
DATABASE_URL=sqlite:///./data/healtest.db

# Generate a URL-safe value with: py -c "import secrets; print(secrets.token_hex(32))"
# Required by Docker Compose; Redis is password-protected and not published on the host.
REDIS_PASSWORD=
# Local-only Redis URL. Compose builds its authenticated URL from REDIS_PASSWORD.
REDIS_URL=redis://localhost:6379/0

# Live diagnosis requires a provider-compatible chat-completions endpoint.
# Configure the exact endpoint/model identifier supplied with your access.
MUSE_SPARK_API_KEY=
MUSE_SPARK_API_URL=
MUSE_SPARK_MODEL=
MUSE_CODE_API_KEY=
MUSE_CODE_API_URL=
MUSE_CODE_MODEL=
# SAM endpoint: POST JSON with base64 `image` PNG and `text_prompt`;
# return a PNG mask body or JSON with base64 `mask_png`.
SAM_API_URL=
SAM_API_KEY=
HEALTEST_MODEL_TIMEOUT_S=30

# Set to 1 to force mock-model mode (offline dev, default when keys missing).
HEALTEST_MOCK_MODE=1

# Sandbox execution: auto (Docker required; never falls back), docker, or
# local (trusted development only; executes tests with worker privileges).
HEALTEST_SANDBOX=auto
# Wall-clock limit per pytest run, in seconds.
HEALTEST_TIMEOUT_S=300
# API hardening defaults; configure for the expected request and job volume.
HEALTEST_MAX_REQUEST_BYTES=1048576
HEALTEST_JOB_RATE_LIMIT=10
HEALTEST_JOB_RATE_WINDOW_S=60
HEALTEST_JOB_TIMEOUT_S=1800
HEALTEST_STALE_JOB_GRACE_S=60
# Fresh-container sandbox settings. Compose requires an isolated remote
# Docker daemon with mutual TLS; never point this at the host Docker socket.
HEALTEST_SANDBOX_IMAGE=
HEALTEST_SANDBOX_NETWORK=healtest-sandbox
HEALTEST_SANDBOX_ALLOWED_HOSTS=
HEALTEST_SANDBOX_DOCKER_HOST=
# Host directory containing ca.pem, cert.pem, and key.pem (keep private).
HEALTEST_DOCKER_CERT_PATH=
HEALTEST_SANDBOX_CPUS=2
HEALTEST_SANDBOX_MEMORY=1g
# System chromedriver (container path); unset on hosts to use Selenium Manager.
CHROMEDRIVER_PATH=/usr/bin/chromedriver
