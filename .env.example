# Copy to .env and fill in. Never commit .env.
# Demo auth: single shared token expected as `Authorization: Bearer <token>`.
# Leave empty for local no-auth dev.
HEALTEST_API_TOKEN=

# SQLite default (hackathon). Postgres also accepted: postgresql+psycopg2://user:pass@db:5432/healtest
DATABASE_URL=sqlite:///./data/healtest.db

# Redis for RQ. If unset, backend falls back to inline execution (dev only).
REDIS_URL=redis://localhost:6379/0

# Model access — confirm exact names/keys in hackathon docs before Phase 2.
MUSE_SPARK_API_KEY=
MUSE_CODE_API_KEY=
SAM_API_KEY=

# Set to 1 to force mock-model mode (offline dev, default when keys missing).
HEALTEST_MOCK_MODE=1

# Sandbox execution: auto (docker CLI if present, else local), local, docker.
HEALTEST_SANDBOX=auto
# Wall-clock limit per pytest run, in seconds.
HEALTEST_TIMEOUT_S=300
# Fresh-container sandbox settings (HEALTEST_SANDBOX=docker only).
HEALTEST_SANDBOX_IMAGE=healtest-worker
HEALTEST_SANDBOX_NETWORK=healtest_default
HEALTEST_SANDBOX_CPUS=2
HEALTEST_SANDBOX_MEMORY=1g
# System chromedriver (container path); unset on hosts to use Selenium Manager.
CHROMEDRIVER_PATH=/usr/bin/chromedriver
